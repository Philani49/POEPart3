<Window x:Class="POEPart3.Quiz_game"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POEPart3"
        mc:Ignorable="d"
        Title="Quiz_game" Height="450" Width="800">
    <Grid Height="450" Width="800" Background="#FF1E1E2F">
        <!-- Stack panel to cover component as vertical -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="20">

            <!-- Title of the game -->
            <TextBlock
            Text="Cyber Security Quiz [Game]"
            HorizontalAlignment="Center"
            FontSize="28"
            FontWeight="Bold"
            Foreground="White"
            Margin="0,10,0,20"
            />

            <!-- Display question -->
            <TextBlock
            Text="Question to be asked"
            x:Name="DisplayQuestion"
            HorizontalAlignment="Center"
            FontSize="20"
            Foreground="White"
            TextWrapping="Wrap"
            Margin="0,0,0,20"
            />

            <!-- Four buttons for selecting answers -->
            <Button
            x:Name="FirstChoiceButton"
            Click="HandleAnswerSelection"
            Padding="15"
            Margin="0,5"
            FontSize="16"
            Background="#FF3A3F58"
            Foreground="White"
            />

            <Button
            x:Name="SecondChoiceButton"
            Click="HandleAnswerSelection"
            Padding="15"
            Margin="0,5"
            FontSize="16"
            Background="#FF3A3F58"
            Foreground="White"
            />

            <Button
            x:Name="ThirdChoiceButton"
            Click="HandleAnswerSelection"
            Padding="15"
            Margin="0,5"
            FontSize="16"
            Background="#FF3A3F58"
            Foreground="White"
            />

            <Button
            x:Name="FourthChoiceButton"
            Click="HandleAnswerSelection"
            Padding="15"
            Margin="0,5"
            FontSize="16"
            Background="#FF3A3F58"
            Foreground="White"
            />

            <!-- Next question button -->
            <Button
            x:Name="NextQuestionButton"
            Content="Next"
            Click="HandleNextQuestion"
            Padding="10"
            Margin="0,15"
            Background="BurlyWood"
            FontSize="16"
            FontWeight="Bold"
            />

            <!-- Display score -->
            <TextBlock
            x:Name="DisplayScore"
            HorizontalAlignment="Right"
            Text="Play game first"
            Foreground="LightGray"
            FontSize="14"
            Margin="0,10,0,0"
            />
        </StackPanel>
    </Grid>


</Window>
