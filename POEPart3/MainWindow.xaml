<Window x:Class="POEPart3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POEPart3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
     <!-- The side bar-->
        <Grid Width="120" Background="Gray" HorizontalAlignment="Left">
            <StackPanel Margin="10">
                <!-- Button for conversation-->
                <Button Content="Conversation"
                        Click="conversation" 
                     Margin="0,10" Background="DarkGray" 
                        Foreground="Black" 
                        BorderBrush="Transparent"/>

                <!-- Button for Task Manger-->
                <Button
                    Content="Task Manager" 
                    Click="task_manager"
                    Margin="0,10" 
                    Background="DarkGray" 
                    Foreground="Black" 
                    BorderBrush="Transparent"/>

                <!-- Button for game quiz-->
                <Button 
                    Content="Quiz Game" 
                    Click="quiz_game"
                    Margin="0,10"
                    Background="DarkGray"
                    Foreground="Black" 
                    BorderBrush="Transparent"/>

                <!-- Button for Activity log-->
                <Button 
                    Content="Activity Log" 
                    Click="activity_log"
                    Margin="0,10"
                    Background="DarkGray" 
                    Foreground="Black" 
                    BorderBrush="Transparent"/>

                <!-- Button for exit-->
                <Button 
                    Content="Exit" 
                    Click="exit"
                    Margin="0,10" 
                    Background="DarkGray"
                    Foreground="Black" 
                    BorderBrush="Transparent"/>


            </StackPanel>
        </Grid>
        <!--end of sidebar-->
        <!-- Cpontent on the Main area-->
        <Grid Margin="120,0,0,0"
              Background="WhiteSmoke" >
            <TextBlock
                Text="Welcome to cyber security awareness Bot!"
                FontSize="24"
                FontWeight="DemiBold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>
              
    </Grid>
</Window>
